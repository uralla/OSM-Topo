# -------------------------------------------------------------------
# This is the default mkgmap style file for converting closed OSM ways
# into Garmin polygons.
# Any line prefaced with # is a comment and will not be applied.
# Each line is a rule, of the generalised format:
#  OSM_tag(s)_to_match  [Garmin_type_code resolution]
# See http://wiki.openstreetmap.org/wiki/mkgmap/help/style_rules
# and http://wiki.openstreetmap.org/wiki/mkgmap/help/Custom_styles
# for more information.

addr:housenumber=* {set mkgmap:execute_finalize_rules=true}

leisure=* & sport=* & name=* { set name='${name} (${sport})' }

leisure=fitness_station & sport=* { set leisure=playground }

# [CUSTOM/АВТОРСКОЕ] Both current logging and legacy clearcut tagging use the
# same scrub/clearcut visual class below. For man_made=clearcut this also lets
# the generic man_made cleanup remove only the obsolete man_made tag without
# losing the intended polygon classification.
(man_made=clearcut | landuse=logging) { add natural=scrub }

# Все бесхозные man_made до зданий
man_made=* & landuse=* {delete man_made}
man_made=* & natural=* {delete man_made}

man_made=water_works [0x0c resolution 22]
man_made=wastewater_plant [0x1321d resolution 24]

man_made=geoglyph { name '${name}' | 'геоглиф' } [0x1181b resolution 24]

# Пирсы и волнорезы: один и тот же серый polygon. Это правило должно быть
# раньше широкого man_made=* & area=yes, иначе breakwater станет зданием 0x13.
(man_made=pier | man_made=breakwater) [0x10f11 resolution 24]

# Для видимой подписи реальное имя важнее адреса. Адресные поля отдельно
# формируются в inc/address и остаются доступны для поиска Garmin.
tourism=attraction & natural=water {delete tourism}

man_made=* & area=yes 			{name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x13 resolution 24]
(building=* | bridge=yes & area=yes) 	{name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x13 resolution 24]
tourism=attraction & building!=* & leisure!=* & natural!=*	{name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x0d resolution 22]
# Theme parks have an intentional earlier overview polygon than the generic tourism fallback.
tourism=theme_park [0x0d resolution 21]
tourism=* & building!=* & leisure!=* {name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x0d resolution 22]

# man_made can be used on areas or lines
man_made=* & area!=no
& (man_made!=door & man_made!=embankment & man_made!=breakwater
   & man_made!=cable_line & man_made!=cutline & man_made!=cutting
   & man_made!=levee & man_made!=trench
   & man_made!=groyne & man_made!=reinforced_slope)
	{name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' }[0x13 resolution 24]

include 'inc/name';
include 'inc/water_polygons';
include 'inc/landuse_polygons';

(aeroway=aerodrome | aeroway=airport) [0x07 resolution 18]
aeroway=runway {name '${ref}'} [0x0e resolution 18]
(aeroway=taxiway | aeroway=taxilane) {name '${ref}'} [0x0e resolution 24]
aeroway=heliport [0x07 resolution 20]
aeroway=helipad [0x0e resolution 20]

amenity=kindergarten & building!=* [0x0a resolution 22 continue]
amenity=cafe & building!=* | amenity=fast_food & building!=* | amenity=restaurant & building!=* | amenity=food_court & building!=* [0x08 resolution 22]
amenity=college & building!=* [0x0a resolution 22]
parking=underground | parking=multi-storey [0x06 resolution 24]
amenity=parking | parking=surface [0x05 resolution 24]
amenity=prison & building!=* [0x04 resolution 22]
amenity=school & building!=* [0x0a resolution 22 continue]
amenity=baby_hatch [0x0a resolution 22 continue]
# amenity=supermarket is superceded by shop=supermarket or landuse=retail
amenity=supermarket & building!=* [0x08 resolution 22]
amenity=university & building!=* [0x0a resolution 22 continue]

amenity=fountain [0x13 resolution 24]

(healthcare=* | amenity=dentist | amenity=doctors | amenity=nursing_home | amenity=hospital | amenity=clinic) & building!=* [0x0b resolution 22-23 continue]
(healthcare=* | amenity=dentist | amenity=doctors | amenity=nursing_home | amenity=hospital | amenity=clinic) & building!=* [0x10908 resolution 24]

landuse=retail & building!=* [0x08 resolution 22-23 continue]
landuse=retail & building!=* [0x10909 resolution 24]

landuse=commercial [0x10f0b resolution 22]

amenity=fire_station & building!=* [0x10f05 resolution 22-23 continue]
amenity=fire_station & building!=* [0x10f06 resolution 24]

power=station [0x0c resolution 23]

leisure=common [0x18 resolution 23]
leisure=garden [0x17 resolution 23]
leisure=golf_course [0x21 resolution 23]
leisure=ice_rink [0x19 resolution 24]
# Legacy nature-reserve tags are a fallback only. Modern boundary tagging above
# already owns the same overview fill and must not be emitted twice.
(leisure=nature_reserve | leisure=natural_reserve | landuse=nature_reserve | landuse=natural_reserve)
    & area_size()>50000 & boundary!=protected_area & boundary!=national_park
    [0x16 resolution 19-22 continue]
leisure=park & mkgmap:area2poi!=true [0x17 resolution 23]
leisure=pitch | leisure=horse_riding  [0x19 resolution 24]
leisure=playground | leisure=recreation_ground [0x17 resolution 23]
leisure=sports_centre { name '${name}' } [0x10612 resolution 23]
leisure=stadium { name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x19 resolution 23]
# Legacy amenity=swimming_pool is normalized into the same polygon branch as
# the current leisure=swimming_pool tagging. Point POIs remain intentionally hidden.
amenity=swimming_pool & leisure!=* { add leisure=swimming_pool }
leisure=swimming_pool { set sport=swimming }
leisure=swimming_pool { name '${name}' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' } [0x19 resolution 24]
leisure=track { name '${name}' } [0x19 resolution 24]
leisure=water_park [0x19 resolution 23]
# Nature reserves intentionally lose polygon fill after resolution 22; private
# access must not reintroduce a generic leisure fill at close zoom.
leisure=* & access=private & leisure!=nature_reserve & leisure!=natural_reserve [0x19 resolution 23]
leisure=dog_park { name '${name}' | 'площадка для собак' } [0x20 resolution 24]
leisure=bleachers [0x1331a resolution 24]

place=town & building!=* [0x01 resolution 19]
place=city & building!=* [0x02 resolution 18]
place=suburb & building!=* [0x02 resolution 22]
place=village & building!=* [0x03 resolution 21]
place=hamlet & building!=* [0x03 resolution 21]
place=locality & building!=* [0x03 resolution 21]
place=isolated_dwelling & building!=* [0x03 resolution 21]

# Fuel is the primary area classification. A convenience shop on the same OSM
# polygon must not turn the whole filling-station area into a retail polygon.
shop=* & building!=* & amenity!=fuel [0x08 resolution 21]

## Площадки на заправках
(highway=* & amenity=fuel) | (amenity=fuel & area=yes)
	{delete highway; set highway=rest_area; set area=yes}
highway=rest_area {set area=yes}
amenity=fuel {set area=yes}
amenity=fuel & area=yes [0x10f0c resolution 24]

# squares and plazas
highway=pedestrian & (area=yes | mkgmap:mp_created=true)
	| highway=footway & (area=yes | mkgmap:mp_created=true)
	| highway=rest_area & (area=yes | mkgmap:mp_created=true)
	| highway=living_street & (area=yes | mkgmap:mp_created=true)
	| highway=residential & (area=yes | mkgmap:mp_created=true)
	| highway=unclassified & (area=yes | mkgmap:mp_created=true) [0x10f12 resolution 21]

# ж/д платформы как площади
(public_transport=platform & area=yes & mkgmap:area2poi!=true | railway=platform & area=yes & mkgmap:area2poi!=true) & !(layer<0) { name '${name}' | 'платформа' } [0x0d resolution 21]

historic=museum | historic=memorial [0x1e resolution 21]
historic=archaeological_site | historic=ruins [0x1e resolution 21]

# render named islands
place=island & name=* [0x53 resolution 18]
place=islet & name=* [0x53 resolution 19]

<finalize>
# The finalizer section is executed for each element when a rule with an element type matches
include 'inc/address';

name=* { name '${name}' }
