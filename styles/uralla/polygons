# -------------------------------------------------------------------
# This is the default mkgmap style file for converting closed OSM ways
# into Garmin polygons.
# Any line prefaced with # is a comment and will not be applied.
# Each line is a rule, of the generalised format:
#  OSM_tag(s)_to_match  [Garmin_type_code resolution]
# See http://wiki.openstreetmap.org/wiki/Mkgmap/help/style_rules
# and http://wiki.openstreetmap.org/wiki/Mkgmap/help/Custom_styles
# for more information.

addr:housenumber=* {set mkgmap:execute_finalize_rules=true}



leisure=* & sport=* & name=* { set name='${name} (${sport})' }

leisure=fitness_station & sport=* { set leisure=playground }

man_made=clearcut {add natural=heath}

# Все бесхозные man_made до зданий
man_made=* & landuse=* {delete man_made}
man_made=* & natural=* {delete man_made}

man_made=water_works [0x0c resolution 22]
man_made=wastewater_plant [0x1321d resolution 24]


man_made=geoglyph { set name='геоглиф' } [0x1181b resolution 24]

# Пирсы 
man_made=pier  [0x10f11 resolution 24]

# здания с улицами, номерами домов и, если есть, с названиями

tourism=attraction & natural=water {delete tourism}

man_made=* & area=yes 			{name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x13 resolution 24]
#man_made=* 				{name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x13 resolution 24]
(building=* | bridge=yes & area=yes) 	{name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x13 resolution 24]
tourism=attraction & building!=* & leisure!=* & natural!=*	{name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x0d resolution 22]
tourism=* & building!=* & leisure!=* {name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x0d resolution 22]

# man_made can be used on areas or lines
man_made=* & area!=no
& (man_made!=door & man_made!=embankment & man_made!=breakwater
   & man_made!=cable_line & man_made!=cutline & man_made!=cutting
   & man_made!=levee & man_made!=trench
   & man_made!=groyne & man_made!=reinforced_slope)
	{name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}'  }[0x13 resolution 24]

include 'inc/name';
include 'inc/water_polygons';
include 'inc/landuse_polygons';

aeroway=airport [0x07 resolution 18]
aeroway=aerodrome [0x07 resolution 18]
aeroway=runway {name '${ref}'} [0x0e resolution 18]
(aeroway=taxiway | aeroway=taxilane) {name '${ref}'} [0x0e resolution 24]
aeroway=heliport [0x07 resolution 20]
aeroway=helipad [0x0e resolution 20]


amenity=kindergarten & building!=* [0x0a resolution 22 continue]
amenity=cafe & building!=* | amenity=fast_food & building!=* | amenity=restaurant & building!=* | amenity=food_court & building!=* [0x08 resolution 22]
amenity=college & building!=* [0x0a resolution 22]
amenity=grave_yard [0x1a resolution 22]
parking=underground | parking=multi-storey [0x06 resolution 24]
amenity=parking | parking=surface [0x05 resolution 24]
amenity=prison & building!=* [0x04 resolution 22]
amenity=school & building!=* [0x0a resolution 22 continue]
amenity=baby_hatch [0x0a resolution 22 continue]
# amenity=supermarket is superceded by shop=supermarket or landuse=retail
amenity=supermarket & building!=* [0x08 resolution 22]
amenity=university & building!=* [0x0a resolution 22 continue]

amenity=fountain [0x13 resolution 24]

amenity=bus_station [0x05 resolution 22]

(healthcare=* | amenity=dentist | amenity=doctors | amenity=nursing_home | amenity=hospital | amenity=clinic) & building!=* [0x0b resolution 22-23 continue]
(healthcare=* | amenity=dentist | amenity=doctors | amenity=nursing_home | amenity=hospital | amenity=clinic) & building!=* [0x10908 resolution 24]

landuse=retail & building!=* [0x08 resolution 22-23 continue]
landuse=retail & building!=* [0x10909 resolution 24]

landuse=commercial [0x10f0b resolution 22]

amenity=fire_station & building!=* [0x10f05 resolution 22-23 continue]
amenity=fire_station & building!=* [0x10f06 resolution 24]

power=station [0x0c resolution 23]

leisure=common [0x18 resolution 23]
leisure=garden [0x17 resolution 23]
leisure=golf_course [0x21 resolution 23]
leisure=ice_rink [0x19 resolution 24]
#leisure=marina [0x09 resolution 21]
#leisure=nature_reserve [0x16 resolution 19]
leisure=nature_reserve & area_size()>50000 | leisure=natural_reserve & area_size()>50000 | landuse=nature_reserve & area_size()>50000 | landuse=natural_reserve & area_size()>50000 [0x16 resolution 19-22 continue]
leisure=park & mkgmap:area2poi!=true [0x17 resolution 23]
leisure=pitch | leisure=horse_riding  [0x19 resolution 24]
#leisure=pitch { name '${name} (${sport})' } [0x19 resolution 24]
leisure=playground | leisure=recreation_ground [0x17 resolution 23]
leisure=sports_centre { name '${name}' } [0x10612 resolution 23]
#leisure=stadium [0x19 resolution 20]
leisure=stadium { name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x19 resolution 23]
leisure=swimming_pool | amenity=swimming_pool {set sport=swimming}
leisure=swimming_pool { name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x19 resolution 24]
#leisure=track & area=yes [0x19 resolution 21]
leisure=track { name '${name}' } [0x19 resolution 24]
leisure=water_park [0x19 resolution 23]
leisure=* & access=private [0x19 resolution 23]
leisure=dog_park { name 'площадка для собак' } [0x20 resolution 24]
leisure=bleachers [0x1331a resolution 24]


#place=village [0x03 resolution 21]
# Тут работало добавление статусной части к названию нас. пункта. Но cladr:suffix был тотально выпилен из базы умными людьми
#place=town 		{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x01 resolution 19]
#place=city 		{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x02 resolution 19]
#place=suburb 		{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x02 resolution 19]
#place=village 		{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x03 resolution 21]
#place=hamlet 		{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x03 resolution 22]
#place=locality 	{name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x03 resolution 22]
#place=isolated_dwelling {name '${name}, ${cladr:suffix}' | '${name}' | '${place_name}, ${cladr:suffix}' | '${place_name}'} [0x03 resolution 22]



#place=town [0x1321c resolution 19-21 continue]
place=town [0x01 resolution 19]


#place=city [0x1321c resolution 19-21 continue]
place=city 		[0x02 resolution 18]


#place=suburb [0x1321c resolution 19-21 continue]
place=suburb 	[0x02 resolution 22]


place=village 	[0x03 resolution 21]
place=hamlet 	[0x03 resolution 21]
place=locality 	[0x03 resolution 21]
place=isolated_dwelling [0x03 resolution 21]



shop=* & building!=* [0x08 resolution 21]

## Площадки на заправках
highway=* & amenity=fuel | amenity=fuel & area=yes 
	{delete highway; set highway=rest_area; set area=yes}
highway=rest_area {set area=yes}

amenity=fuel {set area=yes}

amenity=fuel & area=yes [0x10f0c resolution 24]

# squares and plazas
#highway=pedestrian & (area=yes | mkgmap:mp_created=true) [0x17 resolution 22]
highway=pedestrian & (area=yes | mkgmap:mp_created=true) 
	| highway=rest_area & (area=yes | mkgmap:mp_created=true)
	| highway=living_street & (area=yes | mkgmap:mp_created=true)
	| highway=residential & (area=yes | mkgmap:mp_created=true)
	| highway=unclassified & (area=yes | mkgmap:mp_created=true) [0x0d resolution 21]

# ж/д платформы как площади
#railway=platform [0x0d resolution 21]
#public_transport=stop_area [0x0d resolution 21]
(public_transport=platform & area=yes & mkgmap:area2poi!=true | railway=platform & area=yes & mkgmap:area2poi!=true) & !(layer<0) { name 'платформа' } [0x0d resolution 21]

# other highways that have area=yes set must be parking lots
highway=* & (area=yes | mkgmap:mp_created=true) [0x05 resolution 21]

historic=museum | historic=memorial [0x1e resolution 21]
historic=archaeological_site | historic=ruins [0x1e resolution 21]
historic=ruins & building=yes {name '${addr:street} ${addr:housenumber} (${name})' | '${addr:street} ${addr:housenumber}' | '${addr:housenumber}' | '${name}' } [0x13 resolution 24]

# building tag should be last
#(building=* | amenity=*) & area!=no & amenity!=grave_yard [0x13 resolution 24]

###tourism=* & area!=no & waterway!=* & building!=* [0x1f resolution 24]

tourism=theme_park [0x0d resolution 21]

# Торфоразработки
landuse=peat_cutting [0x10102 resolution 19]



# render small named islands 
# place=island & name=* & area_size() < 1000000 [0x53 resolution 18]
place=island & name=* [0x53 resolution 18]
place=islet & name=* [0x53 resolution 19]



<finalize>
# The finalizer section is executed for each element when a rule with an element type matches

# we need addrees info from buildings for the address search
include 'inc/address';

name=* { name '${name}' }
