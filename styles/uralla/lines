## Treat disused ways as highway=service, but at lower road_speed.
highway=* & disused=yes [0x12 road_class=0 road_speed=1 resolution 22 continue]

# Lower the road speed of ways under some construction.
highway=* & construction=* & maxspeed!=* { add mkgmap:road-speed = '-1' }
# Lower the road speed of disused ways.
highway=* & disused=yes & maxspeed!=* { add mkgmap:road-speed = '-2' }

highway=primary_link & length()>500 | highway=primary & junction=roundabout & length()>500 [0x03 resolution 20-21 continue]
highway=primary_link | highway=primary & junction=roundabout [0x03 road_class=3 road_speed=5 resolution 22 continue]

# Ways sorted roughly by descending order of class
highway=motorway [0x01 road_class=4 road_speed=6 resolution 16]
highway=trunk & ref=М-5 [0x01 road_class=4 road_speed=6 resolution 14]
highway=motorway_link | highway=motorway & junction=roundabout [0x01 road_class=4 road_speed=4 resolution 19]
highway=trunk [0x02 road_class=4 road_speed=6 resolution 14]
highway=trunk_link | highway=trunk & junction=roundabout [0x02 road_class=4 road_speed=6 resolution 18]
highway=* & motorroad=yes [0x02 road_class=4 road_speed=5 resolution 14]
highway=primary [0x03 road_class=3 road_speed=5 resolution 17]

highway=secondary_link & length()>500 | highway=secondary & junction=roundabout & length()>500 [0x07 resolution 20-21 continue]
highway=secondary_link | highway=secondary & junction=roundabout [0x04 road_class=2 road_speed=5 resolution 22 continue]
highway=secondary & length()>500 [0x07 resolution 18-19 continue]
highway=secondary [0x04 road_class=2 road_speed=5 resolution 20]

highway=tertiary_link & length()>500 | highway=tertiary & junction=roundabout & length()>500 [0x07 resolution 21-22 continue]
highway=tertiary_link | highway=tertiary & junction=roundabout [0x11 road_class=2 road_speed=5 resolution 23 continue]
highway=tertiary & length()>500 [0x07 resolution 18-19 continue]
highway=tertiary [0x11 road_class=2 road_speed=5 resolution 20]

highway=minor & length()>400 [0x06 resolution 20-22 continue]
highway=minor [0x06 road_class=1 road_speed=5 resolution 23]

highway=unclassified & length()>500 [0x07 resolution 19-21 continue]
highway=unclassified [0x06 road_class=1 road_speed=4 resolution 22 continue]
highway=unclassified & junction=roundabout [0x06 road_class=1 road_speed=2 resolution 22]

highway=residential & area!=yes & length()>200 [0x07 resolution 22-22 continue]
highway=residential & area!=yes [0x0d road_class=0 road_speed=2 resolution 23]

# Some countries allow, others disallow bicycling on pedestrian streets.
highway=pedestrian & area!=yes [0x07 road_class=0 road_speed=0 resolution 22-23 continue]
highway=pedestrian & area!=yes [0x0e road_class=0 road_speed=0 resolution 24]

highway=living_street [0x06 road_class=0 road_speed=1 resolution 23]

# [CUSTOM/АВТОРСКОЕ] Marked route members: one extra LOD step.
# Emit only the additional farther level; normal rules below render the usual levels.
mkgmap:trail_name=* & highway=cycleway & length()>100 [0x07 resolution 21-21 continue]
mkgmap:trail_name=* & bicycle=yes & highway=path & length()>100 [0x0b resolution 21-21 continue]
mkgmap:trail_name=* & highway=footway & length()>100 [0x07 resolution 21-21 continue]
mkgmap:trail_name=* & bicycle!=yes & highway=path & length()>100 [0x0b resolution 22-22 continue]
mkgmap:trail_name=* & highway=track & tracktype!=grade1 & length()>100 [0x12 resolution 21-21 continue]
mkgmap:trail_name=* & highway=track & tracktype=grade1 & length()>100 [0x07 resolution 20-20 continue]
mkgmap:trail_name=* & highway=bridleway & length()>100 [0x16 resolution 23-23 continue]

highway=bridleway [0x16 road_class=0 road_speed=0 resolution 24]
highway=byway [0x16 road_class=0 road_speed=0 resolution 24]

# parking_aisle is intentionally removed in inc/water_lines.
highway=service & (service=alley|service=driveway) [0x07 road_class=0 road_speed=0 resolution 23]
highway=service & oneway=yes [0x07 road_class=0 road_speed=1 resolution 23]
highway=service & length()>200 [0x07 resolution 23-23 continue]
highway=service [0x0d road_class=0 road_speed=2 resolution 24]

# Mop up any unrecognised highway types
highway=* & area!=yes & highway!=path & highway!=steps & highway!=footway & highway!=track & highway!=cycleway & highway!=service [0x07 road_class=0 road_speed=0 resolution 24]

highway=cycleway & length()>200 [0x07 resolution 22-23 continue]
highway=cycleway [0x0e road_class=0 road_speed=1 resolution 24]

bicycle=yes & highway=path & length()>100 | highway=footway & length()>100 [0x0b resolution 22-23 continue]
bicycle=yes & highway=path [0x16 road_class=0 road_speed=1 resolution 24]

highway=footway & length()>100 [0x07 resolution 22-23 continue]
highway=footway [0x0e road_class=0 road_speed=1 resolution 24]

bicycle!=yes & highway=path & length()>100 [0x0b resolution 23-23 continue]
bicycle!=yes & highway=path [0x2e road_class=0 road_speed=0 resolution 24]

highway=road { add mkgmap:dead-end-check = false} [0x05 road_class=0 road_speed=1 resolution 21]

highway=track & tracktype!=grade1 & length()>100 {add mkgmap:display_name = '${name}'} [0x12 resolution 22-23 continue]
highway=track & tracktype=grade1 & length()>100 {add mkgmap:display_name = '${name}'} [0x07 resolution 21-23 continue]
highway=track [0x0a road_class=0 road_speed=1 resolution 24]

# power lines
power=line {name '${name} ${ref}' | '${name}' | '${ref}' }
power=line & length()>500 | (power=line & man_made=cutline & length()>500) [0x29 resolution 21-23 continue]
power=line | (power=line & man_made=cutline) | power=minor_line [0x29 resolution 24]
man_made=cutline & power!=line [0x10f10 resolution 24]

## недейств. ж/д
railway=abandoned | (railway=* & abandoned=yes) | railway=disused
{ name '${name} (недейств. ж/д)' | 'недейств. ж/д' }

## недейств. ужд
railway=narrow_gauge & (disused=yes | abandoned=yes) { name '${name} (недейств. ужд)' | 'недейств. ужд' }

## Разделяем ЖД с трамваями и выносим их в кастомные типы
railway=abandoned | railway=disused | railway=* & disused=yes | railway=* & abandoned=yes [0x1011a resolution 23-24]
railway=light_rail & !(layer<0) [0x10f14 resolution 22-24]
# narrow_gauge is consumed in inc/water_lines and uses the tram type 0x10f14.

railway=rail & service=* & length()>500 [0x10f1f resolution 23-23 continue]
railway=rail & service=* [0x10f1f resolution 24]

railway=rail & usage=main [0x10f13 resolution 19-20 continue]
railway=rail & service!=* | railway=rail & usage=main [0x10f13 resolution 21-24 continue]
(railway=preserved) & !(tunnel=yes) [0x10e1a resolution 24]

railway=tram & usage=main & length()>500 [0x10f14 resolution 22-23 continue]
railway=tram [0x10f14 resolution 24]

# Underground subway is consumed in inc/water_lines; above-ground is retained.
railway=subway [0x10e1a resolution 23-24 continue]
railway=platform & area!=yes [0x16 road_class=0 road_speed=0 resolution 24 continue]

# Pipelines have their own farther LOD rule. Keep the broad cable/pipe fallback
