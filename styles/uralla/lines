(man_made=cable|(man_made=* & man_made!=pipeline & man_made ~ '.*pipe.*')) & area!=yes &
tunnel!=yes & location != underground
{name '${name} (${operator})' | '${name}' | '${operator}' }
[0x28 resolution 23]

# трубопроводы
man_made=pipeline {name '${name}' | '${operator}'} [0x28 resolution 22]

# The following boundary styles are after the highway rules because ways
