# highway=* & name!=* { name '${mkgmap:city}' }

#limit artificial cycleways to resolution 24
mkgmap:synthesised=yes & mkgmap:bicycle=yes { set mkgmap:highest-resolution-only = true }

# don't add house numbers to unnamed or artifical bicycle ways
mkgmap:bicycle=yes & (mkgmap:foot=no & mkgmap:car=no & mkgmap:street!=* | mkgmap:synthesised=yes) {set mkgmap:numbers=false}

### Удаляем адреса с линий
  waterway=canal 	| waterway=river		| waterway=rapid 
| waterway=rapids 	| whitewater=rapid 		| whitewater=rapids 
| waterway=drain 	| waterway=stream 		
| (highway=path & name!=*)	| (highway=footway & name!=*) | (highway=byway & name!=*) | (highway=pedestrian & name!=*)
  {set mkgmap:numbers=false}

# Display highway shield for mayor roads if they have a ref and make them searchable by their name
(highway=motorway | highway=trunk) & ref=* { name '${ref|highway-symbol:hbox}'; addlabel '${name}' }
highway=primary & ref=* { name  '${ref|highway-symbol:box}'; addlabel '${name}' }
(highway=secondary | highway=tertiary | highway=unclassified) & ref=* { name '${ref|highway-symbol:oval}'; addlabel '${name}' }

name=* { name '${name}' }

highway=* & ref=* & highway!=motorway & highway!=trunk & highway!=primary & highway!=secondary & highway!=tertiary { addlabel '${ref}' }

highway=* & int_ref=* { addlabel '${int_ref}' }
highway=* & nat_ref=* { addlabel '${nat_ref}' }
highway=* & reg_ref=* { addlabel '${reg_ref}' }


# плохая гравийка
(highway=track | highway=service | highway=unclassified ) & (surface=gravel|surface=compacted|surface=paved|surface=pebblestone|surface=fine_gravel) & (smoothness=very_horrible|smoothness=impassable|smoothness=horrible)
	{ name '${ref|highway-symbol:oval}'; addlabel '${name} (плохая гравийка)' | '${name} (плохая гравийка)' | 'плохая гравийка' }

	
# гравийка
(highway=track | highway=service | highway=unclassified ) & (surface=gravel|surface=compacted|surface=paved|surface=pebblestone|surface=fine_gravel) 
	{ name '${ref|highway-symbol:oval}'; addlabel '${name} (гравийка)' | '${name} (гравийка)' | 'гравийка' }

	
# плохая грунтовка
(highway=track | highway=service | highway=unclassified ) & (surface=ground|surface=mud|surface=sand|surface=grass|surface=unpaved|surface=clay) & (smoothness=very_horrible|smoothness=impassable|smoothness=horrible) 
	{ name '${ref|highway-symbol:oval}'; addlabel '${name} (плохая грунтовка)' | '${name} (плохая грунтовка)' | 'плохая грунтовка' }
		
	
# грунтовка
(highway=track | highway=service | highway=unclassified ) & (surface=ground|surface=unpaved|surface=mud|surface=grass|surface=sand|surface=clay)
	{ name '${ref|highway-symbol:oval}'; addlabel '${name} (грунтовка)' | '${name} (грунтовка)' | 'грунтовка' }


highway=* & tunnel=yes  { add name='туннель' }

