natural=ridge & length()>500 { name 'хр. ${name}' } [0x10e02 resolution 18 continue]
natural=ridge { name 'хр. ${name}' } [0x10e01 resolution 23 continue]
natural=cliff [0x10f17 resolution 23 continue]

man_made=embankment [0x10d01 resolution 24]
natural=earth_bank [0x10d01 resolution 23]
natural=gully [0x10e03 resolution 24]
waterway=dam [0x12d01 resolution 23]

