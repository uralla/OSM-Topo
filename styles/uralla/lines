boundary=administrative { name '${mkgmap:boundary_name}' }
boundary=administrative & admin_level<3 [0x1e resolution 24-16]
boundary=administrative & admin_level<5 [0x1d resolution 24-18]
boundary=administrative & admin_level<7 [0x1c resolution 24-20]
boundary=administrative & admin_level<9 [0x1c resolution 24-21]
boundary=administrative & admin_level=10 [0x1c resolution 24-21]
boundary=administrative [0x1c resolution 23-20]
boundary=national [0x1e resolution 14]
boundary=political [0x1c resolution 14]

## Добавляем другие линии
barrier=retaining_wall [0x10d02 resolution 24]
barrier=fence | barrier=hedge | barrier=wall [0x12d1a resolution 24 continue]

## Канатная дорога
