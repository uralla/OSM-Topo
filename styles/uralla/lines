aerialway=gondola    {name '${name} (${ref})' | '${name}' | '${ref}' } [0x10f01 resolution 22]
aerialway=mixed_lift {name '${name} (${ref})' | '${name}' | '${ref}' } [0x10f02 resolution 22]
aerialway=chair_lift {name '${name} (${ref})' | '${name}' | '${ref}' } [0x10f03 resolution 22]
aerialway=drag_lift  {name '${name} (${ref})' | '${name}' | '${ref}' } [0x10f04 resolution 22]
aerialway=* [0x10f15 resolution 22]

## Горнолыжные трассы
piste:type=downhill & piste:difficulty=novice & is_closed()=false & area!=yes [0x10105 resolution 22]
piste:type=downhill & piste:difficulty=easy & is_closed()=false & area!=yes [0x10102 resolution 22]
piste:type=downhill & piste:difficulty=intermediate & is_closed()=false & area!=yes [0x10103 resolution 22]
piste:type=downhill & piste:difficulty=advanced & is_closed()=false & area!=yes [0x10104 resolution 22]
piste:type=skitour & is_closed()=false & area!=yes [0x10101 resolution 22]
