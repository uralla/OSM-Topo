# [IMPORTANT/ВАЖНО] Agreed point rules that must run before broad generic fallbacks.
# A matched Garmin type ends normal point processing unless continue is explicit.

# Fuel: one fuel POI for amenity/waterway=fuel; convenience store gets an additional
# grocery POI. HGV diesel and the duplicate 0x11603 fuel icon are intentionally gone.
(amenity=fuel | waterway=fuel) { set uralla:fuel_rendered=yes } [0x2f01 resolution 24 continue]
uralla:fuel_rendered=yes & amenity=fuel & shop=convenience { name '${name} (продукты)' } [0x2e02 resolution 24 continue]
uralla:fuel_rendered=yes { delete amenity; delete waterway; delete shop; delete fuel:HGV_diesel; delete uralla:fuel_rendered }

# Food: one icon, cuisine details stay in OSM but do not create visual subclasses.
(amenity=restaurant | amenity=cafe | amenity=fast_food | amenity=food_court) [0x2a00 resolution 24]

# Grocery group. Final adaptive visibility is consumed from uralla:poi_lod_class,
# produced by the preprocessor from rarity + activity context + screen pressure +
# intrinsic category floor. Untagged fallbacks preserve legacy safety:
# supermarkets=23, other groceries=24.
# Unnamed convenience shops stay visually unlabeled but expose "магазинчик" on hover.
uralla:poi_lod_class=H & shop=convenience & name!=* { set mkgmap:label:1=' '; set mkgmap:label:2='магазинчик' } [0x2e02 resolution 22]
uralla:poi_lod_class=M & shop=convenience & name!=* { set mkgmap:label:1=' '; set mkgmap:label:2='магазинчик' } [0x2e02 resolution 23]
uralla:poi_lod_class=L & shop=convenience & name!=* { set mkgmap:label:1=' '; set mkgmap:label:2='магазинчик' } [0x2e02 resolution 24]
uralla:poi_lod_class=H & (shop=supermarket | amenity=supermarket | shop=bakers | shop=bakery | shop=butcher | shop=convenience | shop=general | shop=grocery | shop=organic) { name '${name}' } [0x2e02 resolution 22]
uralla:poi_lod_class=M & (shop=supermarket | amenity=supermarket | shop=bakers | shop=bakery | shop=butcher | shop=convenience | shop=general | shop=grocery | shop=organic) { name '${name}' } [0x2e02 resolution 23]
uralla:poi_lod_class=L & (shop=supermarket | amenity=supermarket | shop=bakers | shop=bakery | shop=butcher | shop=convenience | shop=general | shop=grocery | shop=organic) { name '${name}' } [0x2e02 resolution 24]
shop=convenience & name!=* { set mkgmap:label:1=' '; set mkgmap:label:2='магазинчик' } [0x2e02 resolution 24]
(shop=supermarket | amenity=supermarket) { name '${name}' } [0x2e02 resolution 23]
(shop=bakers | shop=bakery | shop=butcher | shop=convenience | shop=general | shop=grocery | shop=organic) { name '${name}' } [0x2e02 resolution 24]

# Bicycle shop remains a distinct tourist-useful POI and uses adaptive LOD.
uralla:poi_lod_class=H & shop=bicycle { name '${name}' | 'велосипеды' } [0x2f18 resolution 22]
uralla:poi_lod_class=M & shop=bicycle { name '${name}' | 'велосипеды' } [0x2f18 resolution 23]
uralla:poi_lod_class=L & shop=bicycle { name '${name}' | 'велосипеды' } [0x2f18 resolution 24]
shop=bicycle { name '${name}' | 'велосипеды' } [0x2f18 resolution 23]
amenity=bicycle_rental { name '${name}' | 'прокат велосипедов' } [0x2f18 resolution 24]
# Bicycle parking is intentionally not rendered for now.
# amenity=bicycle_parking { name '${name}' | 'велопарковка' } [0x2f18 resolution 24]

# Marketplaces: node POIs and area-derived centre POIs use one shopping symbol.
amenity=marketplace { name '${name}' | 'рынок' } [0x2e00 resolution 23]

# Parcel pickup points: current OSM tags plus the deprecated vending-machine form.
# Keep labels simple: use the real name, otherwise a generic designation.
(amenity=parcel_locker | post_office=post_partner | shop=outpost | amenity=vending_machine & vending~'.*parcel_pickup.*') { name '${name}' | 'пункт выдачи' } [0x2f05 resolution 24]

# Car rental and car sharing are one transport-service POI.
(amenity=car_rental | amenity=car_sharing | shop=car_rental) [0x2f0d resolution 24]

# Motor-vehicle shops/services are one class; rental is handled above.
(shop=car_parts | shop=car_repair | shop=car_wrecker | shop=tires | shop=tyres | shop=motorcycle) [0x2f03 resolution 24]

# Ticket shops use the information POI icon. 0x4c00 is NoLabel in the TYP, so
# the primary Garmin label is available to hover/details without permanent map text.
shop=ticket { name '${name}' | 'билеты' } [0x4c00 resolution 24]

# Tourist-useful non-food shops only. Broad shop=* fallback is intentionally absent:
# specialist retail such as books, phones, medical supplies, fashion, etc. is omitted.
uralla:poi_lod_class=H & (shop=hardware | shop=doityourself | shop=houseware) { name '${name}' | 'хозтовары' } [0x2e00 resolution 22]
uralla:poi_lod_class=M & (shop=hardware | shop=doityourself | shop=houseware) { name '${name}' | 'хозтовары' } [0x2e00 resolution 23]
uralla:poi_lod_class=L & (shop=hardware | shop=doityourself | shop=houseware) { name '${name}' | 'хозтовары' } [0x2e00 resolution 24]
(shop=hardware | shop=doityourself | shop=houseware) { name '${name}' | 'хозтовары' } [0x2e00 resolution 24]
uralla:poi_lod_class=H & (shop=sports | shop=outdoor) { name '${name}' | 'спорттовары' } [0x2e00 resolution 22]
uralla:poi_lod_class=M & (shop=sports | shop=outdoor) { name '${name}' | 'спорттовары' } [0x2e00 resolution 23]
uralla:poi_lod_class=L & (shop=sports | shop=outdoor) { name '${name}' | 'спорттовары' } [0x2e00 resolution 24]
(shop=sports | shop=outdoor) { name '${name}' | 'спорттовары' } [0x2e00 resolution 24]

# Tourist accommodation / shelters. Adaptive visibility consumes final LOD class.
uralla:poi_lod_class=H & tourism=guest_house { name '${name}' } [0x2b01 resolution 22]
uralla:poi_lod_class=M & tourism=guest_house { name '${name}' } [0x2b01 resolution 23]
uralla:poi_lod_class=L & tourism=guest_house { name '${name}' } [0x2b01 resolution 24]
tourism=guest_house { name '${name}' } [0x2b01 resolution 24]
uralla:poi_lod_class=H & tourism=hotel { name '${name}' } [0x2b01 resolution 22]
uralla:poi_lod_class=M & tourism=hotel { name '${name}' } [0x2b01 resolution 23]
uralla:poi_lod_class=L & tourism=hotel { name '${name}' } [0x2b01 resolution 24]
tourism=hotel { name '${name}' } [0x2b01 resolution 24]
tourism=motel [0x2b01 resolution 24]
uralla:poi_lod_class=H & tourism=hostel { name '${name}' } [0x2b02 resolution 22]
uralla:poi_lod_class=M & tourism=hostel { name '${name}' } [0x2b02 resolution 23]
uralla:poi_lod_class=L & tourism=hostel { name '${name}' } [0x2b02 resolution 24]
tourism=hostel { name '${name}' } [0x2b02 resolution 24]
amenity=shelter & mkgmap:area2poi!=true [0x2b05 resolution 23]
(tourism=wilderness_hut | tourism=alpine_hut) [0x2b07 resolution 23]

# Long memorial names use the explicit memorial subtype when it is precise enough.
historic=memorial & memorial=plaque & uralla:long_name=yes { name 'памятная табличка' } [0x6403 resolution 24]
historic=memorial & memorial=stele & uralla:long_name=yes { name 'стела' } [0x6403 resolution 24]
historic=memorial & memorial=stone & uralla:long_name=yes { name 'памятный камень' } [0x6403 resolution 24]
historic=memorial & memorial=statue & uralla:long_name=yes { name 'памятник' } [0x6403 resolution 24]
historic=memorial & memorial=obelisk & uralla:long_name=yes { name 'обелиск' } [0x6403 resolution 24]
historic=memorial & memorial=bust & uralla:long_name=yes { name 'бюст' } [0x6403 resolution 24]
historic=memorial & memorial=sculpture & uralla:long_name=yes { name 'скульптура' } [0x6403 resolution 24]
historic=memorial & memorial=cross & uralla:long_name=yes { name 'памятный крест' } [0x6403 resolution 24]
# war_memorial describes purpose rather than physical form, but is still precise enough
# to replace an overlong label with a useful designation.
historic=memorial & memorial=war_memorial & uralla:long_name=yes { name 'воинский мемориал' } [0x6403 resolution 24]
# Remaining overlong memorial names get one generic designation; no deeper subtype audit.
historic=memorial & uralla:long_name=yes { name 'мемориал' } [0x6403 resolution 24]
# Real names win; data-derived text is only a fallback.
historic=memorial { name '${name}' | '${inscription}' } [0x6403 resolution 24]
amenity=signpost { name '${name}' | '${label}' } [0x5a00 resolution 24]

# Information POIs: only the real name or a generic designation may become the label.
# operator/ref remain source/details data and are intentionally excluded from fallbacks.
tourism=information & information=guidepost { name '${name}' | 'указатель' } [0x4c00 resolution 23]
tourism=information & (information=route_marker | information=trail_blaze) { name '${name}' | 'маркер' } [0x4c00 resolution 24]
tourism=information { name '${name}' | 'информация' } [0x4c00 resolution 24]

# Agreed removals from point display. Polygon/line representations are unaffected.
tourism=caravan_site { delete tourism }
(highway=speed_bump | traffic_calming=bump | traffic_calming=hump) { delete highway; delete traffic_calming }
man_made=utility_pole { delete man_made }
(leisure=playground | leisure=sports_center | leisure=sports_centre | leisure=pitch | leisure=swimming_pool | leisure=fitness_centre) { delete leisure }

# Protected areas are represented by area fill + boundary, not a centre POI.
leisure=nature_reserve { delete leisure }
boundary=protected_area { delete boundary }
boundary=national_park { delete boundary }

# Trees: a named tree is already a landmark in its own right, so its tree type wins
# over secondary tags such as tourism=attraction. Needle-leaved named trees use the
# conifer icon; broad-leaved or otherwise unspecified named trees use the tree icon.
# Unnamed trees stay completely out of POI rendering, including attraction fallback.
natural=tree & name=* & leaf_type=needleleaved { name '${name}' } [0x2c09 resolution 24]
natural=tree & name=* { name '${name}' } [0x2c08 resolution 24]
natural=tree & name!=* { delete natural; delete tourism }
natural=shrub & name!=* { delete natural }

# [CUSTOM/АВТОРСКОЕ] Barrier landmarks. The real TYP identifies 0x5800 as
# "шлагбаум / gate" and 0x5801 as "ворота / gateway". This rule is visual only:
# do NOT infer bicycle/foot/access permissions for motorcycle_barrier here.
(barrier=motorcycle_barrier | barrier=cattle_grid) [0x5800 resolution 24]

# [CUSTOM/АВТОРСКОЕ] Trail obstacles: fallen logs/debris are one visual class.
(barrier=log | obstacle=fallen_tree | barrier=debris) [0x6602 resolution 23]

# Agreed terrain / tourist POIs. A real mountain_pass must continue to the richer
# rule in inc/landuse_points instead of being consumed as a generic saddle.
natural=saddle & mountain_pass!=yes [0x640a resolution 23]
natural=arch [0x6601 resolution 23]
# Viewpoints: no synthetic permanent map text. Named viewpoints keep their real name.
# Unnamed viewpoints keep an empty primary Garmin label and a secondary explanatory
# label for object information/hover, so the icon stays clean but remains understandable.
tourism=viewpoint & name=* { name '${name}' } [0x2c04 resolution 23]
tourism=viewpoint & name!=* { set mkgmap:label:1=' '; set mkgmap:label:2='видовая точка' } [0x2c04 resolution 23]
# Cave entrances use one icon progressively across two levels:
# - resolution 23 only: named caves, icon without a permanent label;
# - resolution 24: all caves; named caves show their real name, unnamed caves stay unlabeled.
# The 23-level output is restricted to 23-23 so it cannot duplicate the 24-level POI.
natural=cave_entrance & name=* { set mkgmap:label:1=' ' } [0x6608 resolution 23-23 continue]
natural=cave_entrance & name=* { set mkgmap:label:1='${name}' } [0x6608 resolution 24]
natural=cave_entrance & name!=* { set mkgmap:label:1=' ' } [0x6608 resolution 24]
# Climbing POI: icon only at the closest detail level; keep source name/details.
sport=climbing { set mkgmap:label:1=' ' } [0x6607 resolution 24]
# Cairns are small local navigation markers: only at the closest detail level.
man_made=cairn { name '${name}' | 'тура' } [0x6409 resolution 24]

# Emergency phone legacy/current tags.
(amenity=emergency_phone | emergency=phone) [0x2f12 resolution 23]
(emergency=defibrillator | amenity=defibrillator) { name '${name}' | 'дефибриллятор' } [0x3002 resolution 24]
emergency=first_aid_kit { name '${name}' | 'аптечка' } [0x3002 resolution 24]

# Bicycle repair station shares the dedicated bicycle-service POI at the closest detail level.
amenity=bicycle_repair_station { name '${name}' | 'велосипеды' } [0x2f18 resolution 24]

# Small tourist infrastructure.
leisure=picnic_table [0x4a01 resolution 24]
