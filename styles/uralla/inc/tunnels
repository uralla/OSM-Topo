# [CUSTOM/АВТОРСКОЕ] Highway tunnels use one Garmin line only.
# 0x08 is both the visible tunnel line and the routable road, so the same OSM
# way is never emitted twice into the routing graph. These rules run after
# generic road modifiers (access/toll/surface/roadspeed) and before ordinary
# highway types.
#
# For the current continuity test, raw per-way length is deliberately ignored.
# Tunnel visibility follows only the road class/LOD hierarchy below.

# Primary links and primary roundabouts.
(highway=primary_link | highway=primary & junction=roundabout) & tunnel=yes [0x08 road_class=3 road_speed=5 resolution 20]

# Secondary links and roundabouts.
(highway=secondary_link | highway=secondary & junction=roundabout) & tunnel=yes [0x08 road_class=2 road_speed=5 resolution 20]

# Tertiary links and roundabouts keep the restored tertiary routing class.
(highway=tertiary_link | highway=tertiary & junction=roundabout) & tunnel=yes [0x08 road_class=2 road_speed=5 resolution 21]

# Major roads at their normal overview levels.
highway=motorway & tunnel=yes [0x08 road_class=4 road_speed=6 resolution 16]
highway=motorway_link & tunnel=yes [0x08 road_class=4 road_speed=4 resolution 19]
highway=trunk & tunnel=yes [0x08 road_class=4 road_speed=6 resolution 14]
highway=trunk_link & tunnel=yes [0x08 road_class=4 road_speed=6 resolution 18]

# motorroad=yes wins over the lower physical highway classes in the ordinary style.
highway=* & motorroad=yes & tunnel=yes [0x08 road_class=4 road_speed=5 resolution 14]

highway=primary & tunnel=yes [0x08 road_class=3 road_speed=5 resolution 17]
highway=secondary & tunnel=yes [0x08 road_class=2 road_speed=5 resolution 18]
highway=tertiary & tunnel=yes [0x08 road_class=2 road_speed=5 resolution 18]

# Local-road tunnels start at the same farthest LOD as their ordinary road class,
# so entering a tunnel cannot punch a gap into an otherwise continuous road.
highway=minor & tunnel=yes [0x08 road_class=1 road_speed=4 resolution 20]
highway=unclassified & ref=* & tunnel=yes [0x08 road_class=1 road_speed=4 resolution 19]
highway=unclassified & ref!=* & tunnel=yes [0x08 road_class=0 road_speed=3 resolution 19]

highway=living_street & tunnel=yes [0x08 road_class=0 road_speed=2 resolution 23]
highway=residential & tunnel=yes [0x08 road_class=0 road_speed=3 resolution 22]
highway=service & tunnel=yes [0x08 road_class=0 road_speed=2 resolution 23]
highway=pedestrian & tunnel=yes [0x08 road_class=0 road_speed=1 resolution 22]

# Tracks keep their hierarchy without per-way length pruning.
highway=track & tracktype=grade1 & tunnel=yes [0x08 road_class=0 road_speed=1 resolution 21]
highway=track & tracktype!=grade1 & tunnel=yes [0x08 road_class=0 road_speed=1 resolution 22]

# Close-biased bicycle and walking ways retain their hierarchy without length gates.
highway=cycleway & tunnel=yes [0x08 road_class=0 road_speed=1 resolution 22]
bicycle=yes & highway=path & tunnel=yes [0x08 road_class=0 road_speed=1 resolution 22]
highway=footway & (footway=sidewalk | footway=crossing) & tunnel=yes [0x08 road_class=0 road_speed=0 resolution 22]
highway=footway & footway!=sidewalk & footway!=crossing & tunnel=yes [0x08 road_class=0 road_speed=0 resolution 23]
bicycle!=yes & highway=path & tunnel=yes [0x08 road_class=0 road_speed=0 resolution 23]

# Any other active highway tunnel gets a close-only routable tunnel line.
highway=* & tunnel=yes [0x08 road_class=0 road_speed=0 resolution 24]
