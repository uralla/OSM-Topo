# Settlement polygons use one common zoom for visual consistency.
# Point labels may appear earlier by significance, but all settlement fills
# start together at resolution 22 so they align with the rest of the polygon layer.

place=city              [0x02 resolution 22]
place=town              [0x01 resolution 22]
place=suburb            [0x02 resolution 22]
place=neighbourhood     [0x03 resolution 22]
place=village           [0x03 resolution 22]
place=hamlet            [0x03 resolution 22]
place=isolated_dwelling [0x03 resolution 22]
place=locality          [0x03 resolution 22]
