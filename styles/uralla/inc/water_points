# Water-related point features. Area-derived POIs are deliberately excluded:
# polygons already carry their own water/terrain rendering and must not gain a
# duplicate centre icon if --add-pois-to-areas is enabled in the future.

natural=beach & mkgmap:area2poi!=true [0x6604 resolution 24]

# A glacier may legitimately be mapped as a node when its geometry is unknown.
# 0x650a intentionally uses the native Garmin symbol; no custom TYP override exists.
natural=glacier & mkgmap:area2poi!=true [0x650a resolution 21]

natural=water & name=* & mkgmap:area2poi!=true [0x6603 resolution 21]
natural=waterfall & mkgmap:area2poi!=true | waterway=waterfall & mkgmap:area2poi!=true [0x6508 resolution 21]
(natural=wetland | natural=marsh | natural=swamp | natural=mud | natural=bog)
    & name=* & mkgmap:area2poi!=true [0x6513 resolution 21]

# [CUSTOM/АВТОРСКОЕ] Water sources: seasonal=* except seasonal=no is treated
# as intermittent. The exact season is intentionally not encoded in the label.
(man_made=water_well | man_made=water_tap | amenity=drinking_water | natural=spring)
    & intermittent!=yes & !(seasonal=* & seasonal!=no)
    { addlabel 'вода' } [0x6511 resolution 22]

(man_made=water_well | man_made=water_tap | amenity=drinking_water | natural=spring)
    & (intermittent=yes | (seasonal=* & seasonal!=no))
    { addlabel 'вода (пересых.)' } [0x6512 resolution 23]

amenity=water_point { addlabel 'запас воды' } [0x5001 resolution 23]
