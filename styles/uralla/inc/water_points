# Water-related point features. Area-derived POIs are deliberately excluded:
# polygons already carry their own water/terrain rendering and must not gain a
# duplicate centre icon if --add-pois-to-areas is enabled in the future.

natural=beach & mkgmap:area2poi!=true [0x6604 resolution 24]

# A glacier may legitimately be mapped as a node when its geometry is unknown.
# 0x650a intentionally uses the native Garmin symbol; no custom TYP override exists.
natural=glacier & mkgmap:area2poi!=true [0x650a resolution 21]

natural=water & name=* & mkgmap:area2poi!=true [0x6603 resolution 21]
# Waterfalls follow the same progressive visibility scheme as cave entrances:
# - resolution 23 only: named waterfalls, icon without a permanent label;
# - resolution 24: all waterfalls; named ones keep a compact display label,
#   while unnamed waterfalls stay unlabeled.
# An explicit leading waterfall type word is abbreviated to "вдп"; a clean name
# gets no artificial type prefix. Restricting the first output to 23-23 avoids
# duplicate POIs at resolution 24.
((natural=waterfall | waterway=waterfall) & name=* & mkgmap:area2poi!=true) { set mkgmap:label:1=' ' } [0x6508 resolution 23-23 continue]
((natural=waterfall | waterway=waterfall) & name~'^(Водопад|водопад|ВОДОПАД) ' & mkgmap:area2poi!=true) { name '${name|subst:Водопад =>вдп |subst:водопад =>вдп |subst:ВОДОПАД =>вдп }' } [0x6508 resolution 24]
((natural=waterfall | waterway=waterfall) & name~'^(вод\.|Вод\.|ВОД\.|вдп\.|Вдп\.|ВДП\.) ' & mkgmap:area2poi!=true) { name '${name|subst:вод. =>вдп |subst:Вод. =>вдп |subst:ВОД. =>вдп |subst:вдп. =>вдп |subst:Вдп. =>вдп |subst:ВДП. =>вдп }' } [0x6508 resolution 24]
((natural=waterfall | waterway=waterfall) & name=* & !(name~'^(Водопад|водопад|ВОДОПАД|вод\.|Вод\.|ВОД\.|вдп\.|Вдп\.|ВДП\.) ') & mkgmap:area2poi!=true) { name '${uralla:label}' | '${name}' } [0x6508 resolution 24]
((natural=waterfall | waterway=waterfall) & name!=* & mkgmap:area2poi!=true) { set mkgmap:label:1=' ' } [0x6508 resolution 24]
(natural=wetland | natural=marsh | natural=swamp | natural=mud | natural=bog)
    & name=* & mkgmap:area2poi!=true [0x6513 resolution 21]

# [CUSTOM/АВТОРСКОЕ] Hot springs keep their historical dedicated Garmin POI type.
natural=hot_spring & mkgmap:area2poi!=true [0x6416 resolution 22]

# [CUSTOM/АВТОРСКОЕ] Water sources: seasonal=* except seasonal=no is treated
# as intermittent. Source labels are kept in the POI data but the corresponding
# TYP points use FontStyle=NoLabel so icons stay uncluttered on the map.
# Springs use the shared adaptive POI LOD (H=22, M=23, L=24). Other water
# source classes retain their established fixed visibility.
(man_made=water_well | man_made=water_tap | amenity=drinking_water)
    & intermittent!=yes & !(seasonal=* & seasonal!=no)
    [0x6511 resolution 22]
(man_made=water_well | man_made=water_tap | amenity=drinking_water)
    & (intermittent=yes | (seasonal=* & seasonal!=no))
    { name '${name|subst: (сезонный)=>|subst: (Сезонный)=>} (пересых.)' | 'пересых. источник' }
    [0x6512 resolution 23]

uralla:poi_lod_class=H & natural=spring & intermittent!=yes & !(seasonal=* & seasonal!=no) [0x6511 resolution 22]
uralla:poi_lod_class=M & natural=spring & intermittent!=yes & !(seasonal=* & seasonal!=no) [0x6511 resolution 23]
uralla:poi_lod_class=L & natural=spring & intermittent!=yes & !(seasonal=* & seasonal!=no) [0x6511 resolution 24]
natural=spring & intermittent!=yes & !(seasonal=* & seasonal!=no) [0x6511 resolution 24]

uralla:poi_lod_class=H & natural=spring & (intermittent=yes | (seasonal=* & seasonal!=no)) { name '${name|subst: (сезонный)=>|subst: (Сезонный)=>} (пересых.)' | 'пересых. источник' } [0x6512 resolution 22]
uralla:poi_lod_class=M & natural=spring & (intermittent=yes | (seasonal=* & seasonal!=no)) { name '${name|subst: (сезонный)=>|subst: (Сезонный)=>} (пересых.)' | 'пересых. источник' } [0x6512 resolution 23]
uralla:poi_lod_class=L & natural=spring & (intermittent=yes | (seasonal=* & seasonal!=no)) { name '${name|subst: (сезонный)=>|subst: (Сезонный)=>} (пересых.)' | 'пересых. источник' } [0x6512 resolution 24]
natural=spring & (intermittent=yes | (seasonal=* & seasonal!=no)) { name '${name|subst: (сезонный)=>|subst: (Сезонный)=>} (пересых.)' | 'пересых. источник' } [0x6512 resolution 24]

amenity=water_point [0x5001 resolution 23]
