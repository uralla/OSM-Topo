# [CUSTOM/АВТОРСКОЕ] Far-zoom decluttering for abnormally dense low-class roads.
# uralla:road_density is computed by the semantic preprocess. Density is counted
# per concrete road class: service only competes with service, residential with
# residential, track with track, etc. These rules are intentionally visual-only:
# road_class, road_speed and access semantics of the near routing carrier stay
# the same as the ordinary rules in ../lines.
#
# Marked hiking/bicycle/MTB route members stay privileged. This matters mainly
# for track members now that path/footway/cycleway/bridleway are excluded from
# density analysis altogether.
mkgmap:trail_name=* { delete uralla:road_density; delete uralla:road_density_class }

# ---------------------------------------------------------------------------
# v6 backbone keep rules. A selected trunk must stay visually continuous even
# when OSM splits it into short ways or changes between low road classes. Only
# uralla:road_density=keep bypasses the legacy per-way length thresholds; dense
# and very_dense suppression remains unchanged.
# ---------------------------------------------------------------------------
highway=minor & uralla:road_density=keep [0x06 resolution 20-22 continue]
highway=minor & uralla:road_density=keep [0x06 road_class=1 road_speed=5 resolution 23]

highway=unclassified & uralla:road_density=keep [0x07 resolution 19-21 continue]
highway=unclassified & uralla:road_density=keep & junction!=roundabout [0x06 road_class=1 road_speed=4 resolution 22 continue]
highway=unclassified & uralla:road_density=keep & junction!=roundabout [0x07 road_class=0 road_speed=0 resolution 24]
highway=unclassified & uralla:road_density=keep & junction=roundabout [0x06 road_class=1 road_speed=2 resolution 22]

highway=residential & area!=yes & uralla:road_density=keep [0x07 resolution 22-22 continue]
highway=residential & area!=yes & uralla:road_density=keep [0x0d road_class=0 road_speed=2 resolution 23]

highway=service & (service=alley|service=driveway) & uralla:road_density=keep [0x07 resolution 23-23 continue]
highway=service & (service=alley|service=driveway) & uralla:road_density=keep [0x0d road_class=0 road_speed=0 resolution 24]
highway=service & service!=alley & service!=driveway & oneway=yes & uralla:road_density=keep [0x07 resolution 23-23 continue]
highway=service & service!=alley & service!=driveway & oneway=yes & uralla:road_density=keep [0x0d road_class=0 road_speed=1 resolution 24]
highway=service & service!=alley & service!=driveway & oneway!=yes & uralla:road_density=keep [0x07 resolution 23-23 continue]
highway=service & service!=alley & service!=driveway & oneway!=yes & uralla:road_density=keep [0x0d road_class=0 road_speed=2 resolution 24]

# ---------------------------------------------------------------------------
# legacy minor — ordinary far hierarchy is 20-22, routing carrier at 23.
# ---------------------------------------------------------------------------
highway=minor & uralla:road_density=dense & length()>400 [0x06 resolution 21-22 continue]
highway=minor & uralla:road_density=dense [0x06 road_class=1 road_speed=5 resolution 23]
highway=minor & uralla:road_density=very_dense & length()>400 [0x06 resolution 22-22 continue]
highway=minor & uralla:road_density=very_dense [0x06 road_class=1 road_speed=5 resolution 23]

# ---------------------------------------------------------------------------
# unclassified — ordinary far hierarchy is 19-21, routing carrier at 22.
# dense moves the overview start inward by one resolution; very_dense by two.
# The ordinary non-roundabout rule continues into the generic close carrier at
# resolution 24, so reproduce that close line here before stopping processing.
# ---------------------------------------------------------------------------
highway=unclassified & uralla:road_density=dense & length()>500 [0x07 resolution 20-21 continue]
highway=unclassified & uralla:road_density=dense & junction!=roundabout [0x06 road_class=1 road_speed=4 resolution 22 continue]
highway=unclassified & uralla:road_density=dense & junction!=roundabout [0x07 road_class=0 road_speed=0 resolution 24]
highway=unclassified & uralla:road_density=dense & junction=roundabout [0x06 road_class=1 road_speed=2 resolution 22]

highway=unclassified & uralla:road_density=very_dense & length()>500 [0x07 resolution 21-21 continue]
highway=unclassified & uralla:road_density=very_dense & junction!=roundabout [0x06 road_class=1 road_speed=4 resolution 22 continue]
highway=unclassified & uralla:road_density=very_dense & junction!=roundabout [0x07 road_class=0 road_speed=0 resolution 24]
highway=unclassified & uralla:road_density=very_dense & junction=roundabout [0x06 road_class=1 road_speed=2 resolution 22]

# residential — ordinary overview is resolution 22; dense grids lose that
# overview line but keep the normal routable street at resolution 23.
highway=residential & area!=yes & (uralla:road_density=dense | uralla:road_density=very_dense) [0x0d road_class=0 road_speed=2 resolution 23]

# living_street has no separate overview carrier, so dense grids move its
# complete line from resolution 23 to close-only resolution 24.
highway=living_street & (uralla:road_density=dense | uralla:road_density=very_dense) [0x06 road_class=0 road_speed=1 resolution 24]

# service — ordinary overview is resolution 23 and routing carrier is 24.
# Dense/very-dense grids suppress only the overview carrier.
highway=service & (service=alley|service=driveway) & (uralla:road_density=dense | uralla:road_density=very_dense) [0x0d road_class=0 road_speed=0 resolution 24]
highway=service & service!=alley & service!=driveway & oneway=yes & (uralla:road_density=dense | uralla:road_density=very_dense) [0x0d road_class=0 road_speed=1 resolution 24]
highway=service & service!=alley & service!=driveway & oneway!=yes & (uralla:road_density=dense | uralla:road_density=very_dense) [0x0d road_class=0 road_speed=2 resolution 24]

# ---------------------------------------------------------------------------
# Tracks. Dense/very-dense clusters are still strongly suppressed here. Sparse
# and explicitly kept tracks are handled later in this include without a raw
# per-way length threshold so an OSM road split into short ways stays continuous.
# ---------------------------------------------------------------------------
highway=track & tracktype=grade1 & uralla:road_density=dense & length()>100 {add mkgmap:display_name = '${name}'} [0x07 resolution 22-23 continue]
highway=track & tracktype=grade1 & uralla:road_density=dense [0x0a road_class=0 road_speed=1 resolution 24]
highway=track & tracktype=grade1 & uralla:road_density=very_dense & length()>100 {add mkgmap:display_name = '${name}'} [0x07 resolution 23-23 continue]
highway=track & tracktype=grade1 & uralla:road_density=very_dense [0x0a road_class=0 road_speed=1 resolution 24]

highway=track & tracktype!=grade1 & uralla:road_density=dense & length()>100 {add mkgmap:display_name = '${name}'} [0x12 resolution 23-23 continue]
highway=track & tracktype!=grade1 & uralla:road_density=dense [0x13 road_class=0 road_speed=1 resolution 24]
highway=track & tracktype!=grade1 & uralla:road_density=very_dense [0x13 road_class=0 road_speed=1 resolution 24]

# Marked tracks keep their one-resolution overview priority, but no longer require
# each individual OSM way to exceed 100 m. The close carrier consumes the way so
# the legacy track block later in ../lines cannot duplicate it.
mkgmap:trail_name=* & highway=track & tracktype!=grade1 {add mkgmap:display_name = '${name}'} [0x12 resolution 21-22 continue]
mkgmap:trail_name=* & highway=track & tracktype!=grade1 [0x13 road_class=0 road_speed=2 resolution 23-24]
mkgmap:trail_name=* & highway=track & tracktype=grade1 {add mkgmap:display_name = '${name}'} [0x07 resolution 20-22 continue]
mkgmap:trail_name=* & highway=track & tracktype=grade1 [0x0a road_class=0 road_speed=2 resolution 23-24]

# Any track reaching this point is sparse, unclassified by density, or selected
# as a v6 backbone keep. Do not apply length()>100 here: density already protects
# busy grids, while sparse forest-road continuity is more useful than way-length pruning.
highway=track & tracktype!=grade1 {add mkgmap:display_name = '${name}'} [0x12 resolution 22-23 continue]
highway=track & tracktype=grade1 {add mkgmap:display_name = '${name}'} [0x07 resolution 21-23 continue]
highway=track & tracktype=grade1 [0x0a road_class=0 road_speed=1 resolution 24]
highway=track & tracktype!=grade1 [0x13 road_class=0 road_speed=1 resolution 24]

# highway=road is included in density accounting so it cannot inflate another
# class, but its generic rendering is already close-only (resolution 24), so a
# density hint has no additional visual suppression to apply here.
