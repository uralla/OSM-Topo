# 
landuse=cemetery|landuse=cemetary|amenity=grave_yard [0x6403 resolution 24]
landuse=village_green & name=* [0x2c06 resolution 24]

(landuse=wood | landuse=forest | natural=wood | natural=forest) 
 & name=* & place!=island & place!=islet [0x6618 resolution 24]



landuse=military & name=* [0x640b resolution 24]
(landuse=basin | landuse=reservoir) & name=* [0x650f resolution 21]
landuse=retail & name=* [0x2e00 resolution 21]




man_made=survey_point & name=* {name "${name} (${ele})" | "${name}"} [0x6617 resolution 24]
man_made=survey_point & name!=* { set mkgmap:label:1=' ' } [0x6617 resolution 24]
ele=* & natural!=* & mountain_pass!=yes {name "${ele} м"} [0x6405 resolution 24]

natural=rock {name "${name} (${ele})"} [0x6607 resolution 24]

# cave_entrance is handled earlier in inc/priority_points as 0x6608.
natural=cliff {name "${name}"} [0x6607 resolution 24]


# Low summits: weaker symbol, close zoom only, but keep useful label data.
(natural=peak | natural=hill) & ele < 300 & name=*
 {name "${name} (${ele} м)"} [0x6615 resolution 24]

(natural=peak | natural=hill) & ele < 300 & name!=*
 {name "${ele} м"} [0x6615 resolution 24]

# Generic summits: original LOD hierarchy.
natural=peak & ele=* & name=* & note!=great-peak
| natural=hill & ele=* & name=*
 {name "${name}"} [0x6619 resolution 21-22 continue]

natural=peak & ele=* & name=* & note!=great-peak
| natural=hill & ele=* & name=*
 {name "${name} (${ele} м)"} [0x6614 resolution 23-24 continue]

natural=peak & ele=* & name!=* & note!=great-peak
| natural=hill & ele=* & name!=*
 {name "${ele} м"} [0x6619 resolution 23-24 continue]

# Unknown elevation.
(natural=peak & ele!=* & name=* & note!=great-peak)
| (natural=hill & ele!=* & name=*)
 {name "${name}"} [0x6619 resolution 24]

natural=peak & ele!=* & name!=* & note!=great-peak
| natural=hill & ele!=* & name!=*
 [0x6615 resolution 24]


natural=volcano & note!=great-peak {name "${name}"} [0x2c0c resolution 21-22 continue]
natural=volcano & note!=great-peak & ele=* {name "${name} (${ele} м)"} [0x2c0c resolution 23-24]
natural=volcano & note!=great-peak & ele!=* {name "${name}"} [0x2c0c resolution 23-24]



# natural=peak & ele=* & name=*
# | natural=hill & ele=* & name=*
# | natural=volcano & ele=* & name=*
# {name "${name} (${ele})"} [0x6616 resolution 23]


natural=tree & leaf_type=broadleaved | natural=tree & leaf_type=mixed {name '${name}'} [0x2c08 resolution 24]
natural=tree | natural=shrub | natural=tree & leaf_type=needleleaved {name '${name}'} [0x2c09 resolution 24]
	
# Перевалы с высотой и классом сложности
mountain_pass=yes {name
	 '${name} (${alt_name}), ${ele} (${rtsa_scale})'
	| '${name}, ${ele} (${rtsa_scale})'
	| '${name}, ${ele} (${pass:category})'
	| '${name} (${alt_name}), ${ele} (${pass:category})'
	| '${ele} (${rtsa_scale})'
	| '${ele} (${pass:category})'
	| '${name} (${alt_name}) (${rtsa_scale})'
	| '${name} (${rtsa_scale})'
	| '${name} (${alt_name}) (${pass:category})'
	| '${name} (${pass:category})'
	| '${name} (${alt_name}), ${ele}'
	| '${name}, ${ele}'
	| '${ele}'
	| '${rtsa_scale}'
	| '${name} (${alt_name})'
	| '${name}' } [0x640a resolution 23] 	

# Generic point buildings are a final fallback only. Specialized POIs above win.
(building=yes | building=true) & mkgmap:area2poi!=true [0x6402 resolution 24]
