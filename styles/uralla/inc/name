# Rules for naming objects, based on the following tags:
# name, brand, operator, ref

# delete FIXME values (they should be better used in maintenance maps)
# better use option --ignore-fixme-values
ref ~ '(?i)fix[ _]?+me'		{ delete ref; } 
operator ~ '(?i)fix[ _]?+me'	{ delete operator; }
brand ~ '(?i)fix[ _]?+me'		{ delete brand; }
name ~ '(?i)fix[ _]?+me'		{ delete name; }

# delete duplicate names
operator=${brand} { delete operator; }
operator=${name}  { delete operator; }
brand=${name}     { delete brand; }

# Короткие подписи POI/объектов: иконка уже передаёт тип, но статусную часть имени сохраняем.
name=* { set name='${name|subst:Беседка=>Бес.|subst:беседка=>бес.}' }

### fuel
### diesel=yes
amenity=fuel & fuel:diesel=yes & fuel:lpg=yes 
{ name	'${name} (Diesel, LPG)' |
 	'${operator} (Diesel, LPG)' | 
 	'${brand} (Diesel, LPG)' | 
 	'${ref} (Diesel, LPG)' | 
	'Diesel, LPG'}

amenity=fuel & fuel:diesel=yes 
{ name 	'${name} (Diesel)' | 
	'${operator} (Diesel)' | 
	'${brand} (Diesel)' | 
	'${ref} (Diesel)' | 
	'Diesel'}

amenity=fuel & fuel:lpg=yes 
{ name 	'${name} (LPG)' | 
	'${operator} (LPG)' | 
	'${brand} (LPG)' | 
	'${ref} (LPG)' | 
	'LPG'}

amenity=fuel 
{ name	'${name}' |
 	'${operator}' | 
	'${brand}' |
	'${ref}'}

amenity=fuel & fuel:HGV_diesel=yes 
{ name 	'${name} (Diesel)' | 
	'${operator} (Diesel)' | 
	'${brand} (Diesel)' | 
	'${ref} (Diesel)' | 
	'Diesel'}

### diesel=no
amenity=fuel & fuel:diesel=no & fuel:lpg=yes 
{ name	'${name} (No Diesel, LPG)' |
 	'${operator} (No Diesel, LPG)' | 
 	'${brand} (No Diesel, LPG)' | 
 	'${ref} (No Diesel, LPG)' | 
	'No Diesel, LPG'}

amenity=fuel & fuel:diesel=no 
{ name 	'${name} (No Diesel)' | 
	'${operator} (No Diesel)' | 
	'${brand} (No Diesel)' | 
	'${ref} (No Diesel)' | 
	'No Diesel'}

