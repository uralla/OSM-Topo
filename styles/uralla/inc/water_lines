# Пирсы: закрытые way помечаем как polygon и убираем man_made,
# чтобы старое общее line-правило ниже их не нарисовало. Polygon-style
# восстановит отображение по uralla:pier_polygon.
man_made=pier & is_closed()=true { set uralla:pier_polygon=yes; delete man_made }

# Открытый пирс рисуем один раз как линию, затем убираем только man_made=pier,
# чтобы старое общее правило lines не наложило второй pier, а highway/footway
# и другие независимые теги продолжили обрабатываться основным style.
man_made=pier & is_closed()=false { name 'пирс'; set uralla:pier_rendered=yes } [0x10f07 resolution 24 continue]
uralla:pier_rendered=yes {delete man_made; delete uralla:pier_rendered}

### роутинг по рекам - линия с синими стрелками направления течения на 0-м слое
(waterway=canal 
| waterway=river  
| waterway=rapid 	| waterway=rapids | whitewater=rapid | whitewater=rapids 
| waterway=waterfall 
| waterway=drain  
| waterway=yes
| waterway=stream) & tunnel!=* {add access=no; add taxi=yes} [0x0f road_class=0 road_speed=0 resolution 24 continue]
###


# Статический справочник опорных рек. Ранг выставляет semantic preprocessor.
# continue нужен, чтобы на близких масштабах река также дошла до обычных waterway=river правил ниже.
uralla:river_rank=1 [0x18 resolution 16 continue]
uralla:river_rank=2 [0x18 resolution 17 continue]
uralla:river_rank=3 [0x18 resolution 18 continue]

# Ручной fallback только для регионально важных рек, которые короче порога
# ранжированного каталога. Длинные реки обслуживаются только uralla:river_rank.
waterway=river & name='Чусовая' & length()>500
| waterway=river & name='Юрюзань' & length()>500
| waterway=river & name='Терек' & length()>500
| waterway=river & name='Северная Двина' & length()>500
| waterway=river & name='Катунь' & length()>500
| waterway=river & name='Чуя' & length()>500
| waterway=river & name='Сосьва' & length()>500
| waterway=river & name='Вишера' & length()>500
| waterway=river & name='Лозьва' & length()>500
| waterway=river & name='Косью' & length()>500
| waterway=river & name='Тшугор' & length()>500
| waterway=river & name='Ивдель' & length()>500
| waterway=river & name='Уса' & length()>500
| waterway=river & name='Кожим' & length()>500 [0x18 resolution 18 continue]

# Long rivers/canals are emitted once from resolution 20. Short ones only
# appear at close zoom; excluding long ways here avoids a second identical 0x01f.
waterway=river & length()>500 | waterway=canal & length()>500 [0x01f resolution 20 continue]
waterway=river & length()<=500 | waterway=canal & length()<=500 [0x01f resolution 23]

waterway=drain [0x10109 resolution 24 continue]
waterway=ditch [0x10109 resolution 24 continue]
waterway=* & tunnel=culvert [0x10c03 resolution 24 continue]

(waterway=stream | waterway=drain) & intermittent=yes [0x10f1d resolution 23 continue]
(waterway=stream | waterway=drain) & intermittent=yes [0x10f1e resolution 24]


