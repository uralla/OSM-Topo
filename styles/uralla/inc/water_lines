# Cross-cutting agreed line rules run here because this include is evaluated
# before the broad generic line fallbacks in lines.

# Marked trail relation names are a fallback only for unnamed member ways.
mkgmap:trail_name=* & name!=* { set name='${mkgmap:trail_name}' }

# Agreed road-surface normalization before legacy label/routing fallbacks.
surface=paved { set surface=asphalt }
(surface=dirt | surface=earth | surface=woodchips) { set surface=ground }
surface=snow { add winter_road=yes }
surface=ice { add ice_road=yes }

# Nordic ski routes use the same visual class as skitour only when there is no
# physical highway classification. If highway=* exists (including path/footway/
# cycleway/track), the physical way class owns the Garmin visual and piste:type
# remains seasonal metadata only.
piste:type=nordic & highway!=* & is_closed()=false & area!=yes [0x10101 resolution 22]

# Active railway bridges use the same structural overlay as road bridges.
# Keep lifecycle/hidden-rail filters here because this include runs before the main railway ownership rules.
railway=* & bridge=* & bridge!=no & bridge!=proposed & bridge!=abandoned & area!=yes & tunnel!=yes
& railway!=proposed & railway!=abandoned & railway!=disused & proposed!=* & disused!=yes & abandoned!=yes
& !(railway=light_rail & layer<0) [0x10f16 resolution 24 continue]

# [CUSTOM/АВТОРСКОЕ] Railway classes agreed in the completed tag audit.
# Narrow gauge shares the tram visual class. Disused/abandoned railways continue
# to the dedicated legacy railway rules below instead of being consumed here.
railway=narrow_gauge & disused!=yes & abandoned!=yes { name '${name} (ужд)' | 'ужд' } [0x10f14 resolution 22-24]
railway=funicular & disused!=yes & abandoned!=yes { name '${name}' | 'фуникулер' } [0x10f00 resolution 22]

# Underground subway is intentionally hidden; above-ground subway remains visible.
railway=subway & tunnel=yes { delete railway }

# Parking aisles are intentionally omitted from the visual map and must not fall
# through to the generic highway=service rule.
highway=service & service=parking_aisle { delete highway }

# [CUSTOM/АВТОРСКОЕ] Weirs are relevant hazards/landmarks for water tourism.
# Use the existing dam visual class; continue preserves any independent tags.
waterway=weir [0x12d01 resolution 23 continue]

# Piers, breakwaters, groynes and quays share one simple structural visual class.
# Closed ways become polygons; open ways are rendered once as 0x10f07 lines.
(man_made=pier | man_made=breakwater | man_made=groyne | man_made=quay) & is_closed()=true { set uralla:pier_polygon=yes; delete man_made }

man_made=pier & is_closed()=false { name '${name}' | 'пирс'; set uralla:pier_rendered=yes } [0x10f07 resolution 24 continue]
man_made=breakwater & is_closed()=false & area!=yes { name '${name}' | 'волнорез'; set uralla:pier_rendered=yes } [0x10f07 resolution 24 continue]
man_made=groyne & is_closed()=false & area!=yes { name '${name}' | 'буна'; set uralla:pier_rendered=yes } [0x10f07 resolution 24 continue]
man_made=quay & is_closed()=false & area!=yes { name '${name}' | 'набережная'; set uralla:pier_rendered=yes } [0x10f07 resolution 24 continue]
uralla:pier_rendered=yes {delete man_made; delete uralla:pier_rendered}

# Water routing was intentionally removed. A routable 0x0f carrier could be
# reoriented by mkgmap/Garmin and made flow-direction arrows disagree with the
# source OSM way direction. Waterways are visual map features only.
#
# Restore flow direction separately with the existing non-routable directional
# 0x10f11 TYP line. Emit it before the visual water line so intermittent and
# ordinary waterways can still own their normal width/dash style afterwards.
(waterway=river | waterway=stream | waterway=drain | waterway=canal)
 & area!=yes & tunnel!=yes [0x10f11 resolution 24 continue]

# Статический справочник опорных рек. Ранг выставляет semantic preprocessor.
# Landmark rivers keep a progressive visual hierarchy: thin 0x18 at far zoom,
# medium 0x19 at 20-21, then the 3px 0x1f river line from resolution 22.
uralla:river_rank=1 { set uralla:river_landmark=yes } [0x18 resolution 16-19 continue]
uralla:river_rank=2 { set uralla:river_landmark=yes } [0x18 resolution 17-19 continue]
uralla:river_rank=3 { set uralla:river_landmark=yes } [0x18 resolution 18-19 continue]

# Ручной fallback только для регионально важных рек, которые короче порога
# ранжированного каталога. Длинные реки обслуживаются только uralla:river_rank.
waterway=river & name='Чусовая' & length()>500
| waterway=river & name='Юрюзань' & length()>500
| waterway=river & name='Терек' & length()>500
| waterway=river & name='Северная Двина' & length()>500
| waterway=river & name='Катунь' & length()>500
| waterway=river & name='Чуя' & length()>500
| waterway=river & name='Сосьва' & length()>500
| waterway=river & name='Вишера' & length()>500
| waterway=river & name='Лозьва' & length()>500
| waterway=river & name='Косью' & length()>500
| waterway=river & name='Тшугор' & length()>500
| waterway=river & name='Ивдель' & length()>500
| waterway=river & name='Уса' & length()>500
| waterway=river & name='Кожим' & length()>500 { set uralla:river_landmark=yes } [0x18 resolution 18-19 continue]

uralla:river_landmark=yes [0x19 resolution 20-21 continue]
uralla:river_landmark=yes [0x01f resolution 22-24]

# Ordinary rivers progress through the same widths, but the 3px 0x1f line is
# reserved for the closest resolution. Long rivers get the thin overview first;
# short rivers enter at the medium line.
waterway=river & uralla:river_landmark!=yes & length()>500 [0x18 resolution 20-21 continue]
waterway=river & uralla:river_landmark!=yes [0x19 resolution 22-23 continue]
waterway=river & uralla:river_landmark!=yes [0x01f resolution 24]

# [CUSTOM/АВТОРСКОЕ] ditch is visible only at the closest level and remains
# visually distinct from stream/drain/canal.
waterway=ditch [0x10109 resolution 24 continue]
waterway=* & tunnel=culvert [0x10c03 resolution 24 continue]

# Intermittent streams/drains use a thin dash at 23 and a thicker dash at 24.
# Keep the ranges disjoint so the two TYP lines do not overlap at resolution 24.
(waterway=stream | waterway=drain) & intermittent=yes [0x10f1d resolution 23-23 continue]
(waterway=stream | waterway=drain) & intermittent=yes [0x10f1e resolution 24]

# Waterfalls are POIs; no additional waterfall line is emitted.

### пороги
waterway=rapid | waterway=rapids | whitewater=rapid | whitewater=rapids
    {name '${whitewater:section_name}, пор. ${whitewater:section_grade}' | '${whitewater:section_name}, пор. ${whitewater:rapid_grade}' |
    '${whitewater:rapid_name}, пор. ${whitewater:section_grade}' | '${whitewater:rapid_name}, пор. ${whitewater:rapid_grade}'} [0x1001f resolution 18 continue]

# Restore the original progressive stream hierarchy independently from drain/canal:
# thin long stream at 21-22, medium stream at 23, thick stream at 24.
# Intermittent streams are consumed by the custom dash rules above instead.
waterway=stream & intermittent!=yes & length()>500 [0x18 resolution 21-22 continue]
waterway=stream & intermittent!=yes [0x19 resolution 23 continue]
waterway=stream & intermittent!=yes [0x01f resolution 24]

# Drain/canal are intentionally left on their current hierarchy pending a
# separate review; do not infer their final LOD from stream behaviour.
(waterway=drain | waterway=canal) & length()>500 [0x18 resolution 21-23 continue]
(waterway=drain | waterway=canal) [0x19 resolution 24 continue]
