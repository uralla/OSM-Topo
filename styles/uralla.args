#
# Default options for all my maps
#
gmapsupp
make-poi-index

code-page=1251

road-name-pois
verbose

route
drive-on=detect,right
process-destination
process-exits
make-cycleways
#report-roundabout-issues


index
location-autofill=is_in,nearest
x-split-name-index
housenumbers
add-boundary-nodes-at-admin-boundaries
#add-pois-to-areas


#transparent
max-jobs=4
tdbfile
split-name-index
lower-case





#hide-gmapsupp-on-pc
gmapi


reduce-point-density-polygon=4
#reduce-point-density=5
min-size-polygon=10

simplify-lines=24:2,23:3,22:5,21:8,20:12,19:18,18:24,17:28,16:35


merge-lines
allow-reverse-merge

ignore-fixme-values
draw-priority=25
improve-overview

order-by-decreasing-area
cycle-map
link-pois-to-ways
#add-pois-to-areas




remove-ovm-work-files=true
copyright-message=Config & Style (c) Uralla.ru, https://t.me/Uralla
keep-going

check-styles 

dem=/mnt/nod/dem
dem-dists=5520
overview-dem-dist=276160
dem-interpolation=auto